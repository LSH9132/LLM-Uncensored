# KoboldCPP Configuration

# The version of KoboldCPP to use. 
# "latest" usually maps to the latest release.
# Check https://github.com/LostRuins/koboldcpp/pkgs/container/koboldcpp for tags.
KOBOLD_VERSION=latest

# Context size (e.g., 4096, 8192, 16384, 32768)
# Increase this if you want longer memory, but it consumes more VRAM.
KOBOLD_CONTEXT_SIZE=8192

# Number of layers to offload to the GPU.
# Set to -1 to offload all layers (recommended if VRAM allows).
# Set to 0 to run on CPU only.
KOBOLD_GPU_LAYERS=-1

# Multi-GPU Tensor Split
# If you have multiple GPUs, you can split the model across them.
# Examples:
# "1" : Single GPU (default) or split evenly if multiple detected (behavior varies by backend)
# "1,1" : Split evenly across 2 GPUs
# "3,1" : 75% on GPU 0, 25% on GPU 1
# Leave empty or remove if using a single GPU.
KOBOLD_TENSOR_SPLIT=

# The name of the model file inside the 'models' directory.
# You must place your .gguf file in the ./models folder.
MODEL_FILENAME=my_model.gguf

# Threads to use for generation (usually number of physical cores)
KOBOLD_THREADS=8

# Blas batch size (default 512), increase for faster prompt processing if VRAM allows
KOBOLD_BLAS_BATCH_SIZE=512

# SillyTavern Configuration
SILLYTAVERN_VERSION=latest
